# Copie para /opt/encontrarastudo-admin/admin.env e EDITE. Depois: chmod 600 admin.env
# Senha do painel (escolha uma forte):
ADMIN_PASSWORD=troque-esta-senha
# Chave de sessão (gere uma aleatória; ex.: python3 -c "import secrets;print(secrets.token_hex(32))"):
ADMIN_SECRET=cole-uma-chave-aleatoria-aqui
# Pasta onde o site é publicado (não mudar):
ET_OUT_DIR=/var/www/encontrarastudo
