[Unit]
Description=Encontraras Tudo - Painel Admin
After=network.target

[Service]
User=root
WorkingDirectory=/opt/encontrarastudo-admin
EnvironmentFile=/opt/encontrarastudo-admin/admin.env
ExecStart=/opt/encontrarastudo-admin/venv/bin/gunicorn -w 2 -b 127.0.0.1:8001 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
